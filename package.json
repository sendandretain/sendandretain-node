{
  "name": "@sendandretain/sdk",
  "version": "0.2.0",
  "description": "The Send & Retain SDK for Node.js \u2014 send email, sync contacts and verify webhooks, fully typed from the OpenAPI spec.",
  "license": "MIT",
  "author": "Send & Retain",
  "keywords": [
    "email",
    "transactional-email",
    "api-client",
    "sdk",
    "typescript",
    "openapi",
    "sendandretain",
    "webhooks"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sendandretain/sendandretain-node.git"
  },
  "homepage": "https://github.com/sendandretain/sendandretain-node#readme",
  "bugs": {
    "url": "https://github.com/sendandretain/sendandretain-node/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "gen": "openapi-typescript openapi.json -o src/schema.d.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-schema-sync.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run gen && npm run build",
    "typecheck:examples": "tsc --noEmit -p examples/tsconfig.json"
  },
  "dependencies": {
    "openapi-fetch": "0.14.1",
    "standardwebhooks": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "openapi-typescript": "7.9.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
